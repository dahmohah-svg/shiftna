# Copy this file to .env.local and fill in the values.
# Find them in Supabase: Project Settings > API.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. It is safe in the browser because
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service-role key here or anywhere in the app code.
